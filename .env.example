# UZEX Spot Data AI Agent Environment Variables
# Copy to .env and set your keys

# Google Gemini API Keys (primary + optional secondary for dual-key rotation on 429)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_secondary_gemini_api_key_here

# Configurable model fallback chain (ordered fast-and-cheap first)
# Automatically skips 404 models, retries 503/429/timeouts, and falls back to the next model
LLM_MODELS=gemini:gemini-3.1-flash-lite,gemini:gemini-3-flash-preview,gemini:gemini-3.5-flash,gemini:gemini-3.6-flash,gemini:gemini-3.8-flash,openai:gpt-4o-mini

# Optional: Fallback OpenAI-compatible API (used as final fallback in chain)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# Optional: Fallback Anthropic API
ANTHROPIC_API_KEY=

# SQLite Database Path (default is data/uzex.db)
UZEX_DB_PATH=data/uzex.db

# Server settings
HOST=0.0.0.0
PORT=8000
